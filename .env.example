KADATH_POSTGRES_PASSWORD=change-me
KADATH_MINIO_USER=kadath
KADATH_MINIO_PASSWORD=change-me-please
SEARXNG_SECRET_KEY=replace-with-a-long-random-secret
LITELLM_MASTER_KEY=replace-with-a-long-random-secret
KADATH_MODEL=kadath-default
KADATH_UPSTREAM_MODEL=gpt-4.1
KADATH_MODEL_GLOBAL_CONCURRENCY=64
KADATH_GRADER_CHUNK_TOKENS=12000
KADATH_WORKER_GLOBAL_LIMIT=500
KADATH_BROWSER_FLEET=1
OPENAI_API_KEY=
# Optional independent read-only outcome source. The Architect sees only the
# connector name, never this URL/token, and may select it in the benchmark.
# KADATH_GRADER_CONNECTOR_LEDGER_URL=https://internal-verifier.example/measure
# KADATH_GRADER_CONNECTOR_LEDGER_TOKEN=
# Docker Desktop on macOS: set this to the value reported by `docker context inspect`.
KADATH_DOCKER_SOCKET=/var/run/docker.sock
